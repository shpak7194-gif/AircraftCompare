private fun haversineKm(a: GeoPoint, b: GeoPoint): Double {
    val earthRadiusKm = 6371.0
    val dLat = Math.toRadians(b.latitude - a.latitude)
    val dLon = Math.toRadians(b.longitude - a.longitude)
    val lat1 = Math.toRadians(a.latitude)
    val lat2 = Math.toRadians(b.latitude)

    val h = sin(dLat / 2).pow(2) + cos(lat1) * cos(lat2) * sin(dLon / 2).pow(2)
    return 2 * earthRadiusKm * asin(sqrt(h))
}

private fun farthestReachableCities(rangeKm: Int, limit: Int = 4): List<Pair<City, Double>> {
    return worldCities
        .distinctBy { it.name }
        .map { city -> city to haversineKm(homeAirport, city.point) }
        .filter { (_, distance) -> distance <= rangeKm }
        .sortedByDescending { (_, distance) -> distance }
        .take(limit)
}

// Вычисляет точки вдоль дуги большого круга между двумя координатами
private fun greatCirclePoints(start: GeoPoint, end: GeoPoint, segments: Int = 64): List<GeoPoint> {
    val lat1 = Math.toRadians(start.latitude)
    val lon1 = Math.toRadians(start.longitude)
    val lat2 = Math.toRadians(end.latitude)
    val lon2 = Math.toRadians(end.longitude)

    val d = 2 * asin(
        sqrt(
            sin((lat2 - lat1) / 2).pow(2) +
                    cos(lat1) * cos(lat2) * sin((lon2 - lon1) / 2).pow(2)
        )
    )

    if (d == 0.0) return listOf(start, end)

    val points = mutableListOf<GeoPoint>()

    for (i in 0..segments) {
        val f = i.toDouble() / segments

        val a = sin((1 - f) * d) / sin(d)
        val b = sin(f * d) / sin(d)

        val x = a * cos(lat1) * cos(lon1) + b * cos(lat2) * cos(lon2)
        val y = a * cos(lat1) * sin(lon1) + b * cos(lat2) * sin(lon2)
        val z = a * sin(lat1) + b * sin(lat2)

        val lat = atan2(z, sqrt(x * x + y * y))
        val lon = atan2(y, x)

        points.add(GeoPoint(Math.toDegrees(lat), Math.toDegrees(lon)))
    }

    return points
}

data class FavoritePair(val firstIndex: Int, val secondIndex: Int)

private const val APP_PREFERENCES_NAME = "aircraft_compare_preferences"
private const val FAVORITES_PREFERENCE_KEY = "favorite_pairs"
private const val UNIT_SYSTEM_PREFERENCE_KEY = "unit_system"

private fun loadFavoritePairs(context: Context): List<FavoritePair> {
    val savedValue = context
        .getSharedPreferences(APP_PREFERENCES_NAME, Context.MODE_PRIVATE)
        .getString(FAVORITES_PREFERENCE_KEY, "")
        .orEmpty()

    return savedValue
        .split(";")
        .mapNotNull { savedPair ->
            val indexes = savedPair.split(":", limit = 2)
            val first = indexes.getOrNull(0)?.toIntOrNull()
            val second = indexes.getOrNull(1)?.toIntOrNull()

            if (
                first != null &&
                second != null &&
                first in aircraftList.indices &&
                second in aircraftList.indices
            ) {
                FavoritePair(first, second)
            } else {
                null
            }
        }
        .distinct()
}

private fun saveFavoritePairs(context: Context, favorites: List<FavoritePair>) {
    val valueToSave = favorites.joinToString(separator = ";") { pair ->
        "${pair.firstIndex}:${pair.secondIndex}"
    }

    context
        .getSharedPreferences(APP_PREFERENCES_NAME, Context.MODE_PRIVATE)
        .edit()
        .putString(FAVORITES_PREFERENCE_KEY, valueToSave)
        .apply()
}

private fun loadUnitSystem(context: Context): UnitSystem {
    val savedValue = context
        .getSharedPreferences(APP_PREFERENCES_NAME, Context.MODE_PRIVATE)
        .getString(UNIT_SYSTEM_PREFERENCE_KEY, UnitSystem.METRIC.name)

    return UnitSystem.entries.firstOrNull { it.name == savedValue }
        ?: UnitSystem.METRIC
}

private fun saveUnitSystem(context: Context, unitSystem: UnitSystem) {
    context
        .getSharedPreferences(APP_PREFERENCES_NAME, Context.MODE_PRIVATE)
        .edit()
        .putString(UNIT_SYSTEM_PREFERENCE_KEY, unitSystem.name)
        .apply()
}

@Composable
fun AircraftCompareApp() {
    val context = LocalContext.current
    val storageContext = context.applicationContext

    var firstIndex by rememberSaveable { mutableStateOf(0) }
    var secondIndex by rememberSaveable { mutableStateOf(4) }
    var searchText by rememberSaveable { mutableStateOf("") }
    var manufacturerFilter by rememberSaveable { mutableStateOf("Все") }
    var darkTheme by rememberSaveable { mutableStateOf(false) }
    var cityQuery by rememberSaveable { mutableStateOf("") }
    var unitSystem by remember(storageContext) {
        mutableStateOf(loadUnitSystem(storageContext))
    }

    val favorites = remember(storageContext) {
        mutableStateListOf<FavoritePair>().apply {
            addAll(loadFavoritePairs(storageContext))
        }
    }

    val firstAircraft = aircraftList[firstIndex]
    val secondAircraft = aircraftList[secondIndex]

    val filteredAircraft = aircraftList
        .mapIndexed { index, aircraft -> index to aircraft }
        .filter { (_, aircraft) ->
            val matchesSearch = aircraft.fullName.contains(searchText, ignoreCase = true)
            val matchesManufacturer = manufacturerFilter == "Все" || aircraft.manufacturer == manufacturerFilter
            matchesSearch && matchesManufacturer
        }

    val searchedCity = remember(cityQuery) {
        if (cityQuery.isBlank()) null
        else worldCities.firstOrNull { it.name.contains(cityQuery, ignoreCase = true) }
    }

    val isCurrentFavorite = favorites.any { it.firstIndex == firstIndex && it.secondIndex == secondIndex }

    AircraftTheme(darkTheme) {
        Surface(
            modifier = Modifier.fillMaxSize(),
            color = MaterialTheme.colorScheme.background
        ) {
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .systemBarsPadding()
                    .verticalScroll(rememberScrollState())
                    .padding(16.dp)
            ) {
                Header(
                    darkTheme = darkTheme,
                    onThemeChange = { darkTheme = !darkTheme }
                )

                Spacer(modifier = Modifier.height(12.dp))

                UnitSystemSelector(
                    selectedUnitSystem = unitSystem,
                    onUnitSystemSelected = { selected ->
                        unitSystem = selected
                        saveUnitSystem(storageContext, selected)
