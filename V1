@Composable
private fun AircraftMap(
    aircraft: Aircraft,
    searchedCity: City?,
    unitSystem: UnitSystem
) {
    val context = LocalContext.current

    val mapView = remember {
        MapView(context).apply {
            layoutParams = android.view.ViewGroup.LayoutParams(
                android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                android.view.ViewGroup.LayoutParams.MATCH_PARENT
            )

            setTileSource(cartoTileSource)
            setMultiTouchControls(true)
            controller.setZoom(3.0)
            controller.setCenter(homeAirport)

            setOnTouchListener { view, event ->
                when (event.actionMasked) {
                    MotionEvent.ACTION_DOWN,
                    MotionEvent.ACTION_MOVE -> {
                        parent?.requestDisallowInterceptTouchEvent(true)
                    }

                    MotionEvent.ACTION_UP,
                    MotionEvent.ACTION_CANCEL -> {
                        parent?.requestDisallowInterceptTouchEvent(false)
                    }
                }

                if (event.actionMasked == MotionEvent.ACTION_UP) {
                    view.performClick()
                }

                false
            }
        }
    }

    DisposableEffect(mapView) {
        onDispose { mapView.onDetach() }
    }

    LaunchedEffect(aircraft.fullName, aircraft.rangeKm, searchedCity, unitSystem) {
        mapView.overlays.clear()

        val homeMarker = Marker(mapView).apply {
            position = homeAirport
            title = homeAirportName
        }
        mapView.overlays.add(homeMarker)

        val routes = farthestReachableCities(aircraft.rangeKm)

        routes.forEach { (city, distance) ->
            val line = Polyline(mapView).apply {
                setPoints(greatCirclePoints(homeAirport, city.point))
                outlinePaint.color = 0xFF1565C0.toInt()
                outlinePaint.strokeWidth = 4f
            }
            mapView.overlays.add(line)

            val marker = Marker(mapView).apply {
                position = city.point
                title = city.name
                snippet = "${formatDistance(distance, unitSystem)} от $homeAirportName"
            }
            mapView.overlays.add(marker)
        }

        // Маршрут из поиска — отдельным цветом поверх остальных
        if (searchedCity != null) {
            val searchedLine = Polyline(mapView).apply {
                setPoints(greatCirclePoints(homeAirport, searchedCity.point))
                outlinePaint.color = 0xFFEF6C00.toInt()
                outlinePaint.strokeWidth = 6f
            }
            mapView.overlays.add(searchedLine)

            val searchedMarker = Marker(mapView).apply {
                position = searchedCity.point
                title = searchedCity.name
                snippet = "Из поиска"
            }
            mapView.overlays.add(searchedMarker)

            mapView.controller.animateTo(searchedCity.point)
        }

        mapView.invalidate()
    }

    Box(
        modifier = Modifier
            .fillMaxWidth()
            .height(360.dp)
            .clip(RoundedCornerShape(16.dp))
    ) {
        AndroidView(
            factory = { mapView },
            modifier = Modifier.fillMaxSize()
        )
    }
}
