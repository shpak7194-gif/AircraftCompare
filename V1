private enum class UnitSystem {
    METRIC,
    AVIATION
}

private const val KM_TO_NAUTICAL_MILES = 0.5399568
private const val METERS_TO_FEET = 3.28084
private const val KG_TO_POUNDS = 2.20462

private fun formatDecimal(value: Double): String {
    val rounded = (value * 10).roundToInt() / 10.0
    return rounded
        .toString()
        .removeSuffix(".0")
        .replace('.', ',')
}

private fun formatDistance(km: Double, unitSystem: UnitSystem): String {
    return when (unitSystem) {
        UnitSystem.METRIC -> "${km.roundToInt()} км"
        UnitSystem.AVIATION -> "${(km * KM_TO_NAUTICAL_MILES).roundToInt()} NM"
    }
}

private fun formatLength(meters: Double, unitSystem: UnitSystem): String {
    return when (unitSystem) {
        UnitSystem.METRIC -> "${formatDecimal(meters)} м"
        UnitSystem.AVIATION -> "${formatDecimal(meters * METERS_TO_FEET)} ft"
    }
}

private fun formatWeight(kg: Int, unitSystem: UnitSystem): String {
    return when (unitSystem) {
        UnitSystem.METRIC -> "$kg кг"
        UnitSystem.AVIATION -> "${(kg * KG_TO_POUNDS).roundToInt()} lb"
    }
}

