@Composable
private fun CityRangeChecker(
    query: String,
    onQueryChange: (String) -> Unit,
    matchedCity: City?,
    aircraft: Aircraft,
    unitSystem: UnitSystem
) {
    val distance = matchedCity?.let { haversineKm(homeAirport, it.point) }

    Card(
        modifier = Modifier.fillMaxWidth(),
        shape = RoundedCornerShape(16.dp),
        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
    ) {
        Column(modifier = Modifier.padding(16.dp)) {
            TextField(
                value = query,
                onValueChange = onQueryChange,
                modifier = Modifier.fillMaxWidth(),
                label = { Text("Введи город") },
                placeholder = { Text("Например: Токио, Дубай, Мадрид") },
                singleLine = true,
                shape = RoundedCornerShape(12.dp)
            )

            if (query.isNotBlank()) {
                Spacer(modifier = Modifier.height(12.dp))

                if (matchedCity == null) {
                    Text(
                        text = "Город не найден в базе (~130 крупных городов мира). Попробуй другое написание.",
                        style = MaterialTheme.typography.bodySmall
                    )
                } else if (distance != null) {
                    val reachable = distance <= aircraft.rangeKm
                    val color = if (reachable) Color(0xFF2E7D32) else Color(0xFFC62828)
                    val statusText = if (reachable) "Долетит ✓" else "Не долетит без дозаправки ✕"

                    Text(
                        text = "$statusText — расстояние ${
                            formatDistance(distance, unitSystem)
                        }, дальность самолёта ${
                            formatDistance(aircraft.rangeKm.toDouble(), unitSystem)
                        }",
                        color = color,
                        fontWeight = FontWeight.Medium
                    )
                }
            }
        }
    }
}

