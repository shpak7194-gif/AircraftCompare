@Composable
private fun UnitSystemSelector(
    selectedUnitSystem: UnitSystem,
    onUnitSystemSelected: (UnitSystem) -> Unit
) {
    Row(
        modifier = Modifier.fillMaxWidth(),
        horizontalArrangement = Arrangement.spacedBy(8.dp)
    ) {
        UnitSystem.entries.forEach { unitSystem ->
            val selected = unitSystem == selectedUnitSystem
            val title = if (unitSystem == UnitSystem.METRIC) {
                "Метрические"
            } else {
                "Авиационные"
            }
            val units = if (unitSystem == UnitSystem.METRIC) {
                "км/ч · км · м · кг"
            } else {
                "kt · NM · ft · lb"
            }

            Button(
                onClick = { onUnitSystemSelected(unitSystem) },
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(12.dp),
                colors = ButtonDefaults.buttonColors(
                    containerColor = if (selected) {
                        MaterialTheme.colorScheme.primary
                    } else {
                        MaterialTheme.colorScheme.surfaceVariant
                    },
                    contentColor = if (selected) {
                        MaterialTheme.colorScheme.onPrimary
                    } else {
                        MaterialTheme.colorScheme.onSurfaceVariant
                    }
                )
            ) {
                Column(horizontalAlignment = Alignment.CenterHorizontally) {
                    Text(
                        text = title,
                        fontWeight = FontWeight.SemiBold,
                        fontSize = 12.sp
                    )
                    Text(text = units, fontSize = 10.sp)
                }
            }
        }
    }
}

