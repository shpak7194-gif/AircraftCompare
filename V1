                    Spacer(modifier = Modifier.height(8.dp))

                    ManufacturerFilters(
                        selectedManufacturer = manufacturerFilter,
                        onManufacturerSelected = { manufacturerFilter = it }
                    )

                    Spacer(modifier = Modifier.height(20.dp))

                    SelectionCard(
                        firstAircraft = firstAircraft,
                        secondAircraft = secondAircraft,
                        options = filteredAircraft,
                        onFirstSelected = { firstIndex = it },
                        onSecondSelected = { secondIndex = it }
                    )

                    Spacer(modifier = Modifier.height(20.dp))

                    if (favorites.isNotEmpty()) {
                        FavoritesRow(
                            favorites = favorites,
                            onSelect = { pair ->
                                firstIndex = pair.firstIndex
                                secondIndex = pair.secondIndex
                            },
                            onRemove = { pair ->
                                favorites.remove(pair)
                                saveFavoritePairs(storageContext, favorites)
                            }
                        )
                        Spacer(modifier = Modifier.height(20.dp))
                    }

                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            text = "Результат сравнения",
                            style = MaterialTheme.typography.titleLarge,
                            modifier = Modifier.weight(1f)
                        )

                        IconButton(
                            onClick = {
                                if (isCurrentFavorite) {
                                    favorites.removeAll {
                                        it.firstIndex == firstIndex &&
                                                it.secondIndex == secondIndex
                                    }
                                } else {
                                    favorites.add(FavoritePair(firstIndex, secondIndex))
                                }
                                saveFavoritePairs(storageContext, favorites)
                            }
                        ) {
                            Icon(
                                imageVector = if (isCurrentFavorite) {
                                    Icons.Filled.Star
                                } else {
                                    Icons.Outlined.Star
                                },
                                contentDescription = "В избранное",
                                tint = if (isCurrentFavorite) {
                                    Color(0xFFFFC107)
                                } else {
                                    MaterialTheme.colorScheme.onSurfaceVariant
                                }
                            )
                        }

                        IconButton(
                            onClick = {
                                val summary = buildShareText(
                                    first = firstAircraft,
                                    second = secondAircraft,
                                    unitSystem = unitSystem
                                )
                                val intent = Intent(Intent.ACTION_SEND).apply {
                                    type = "text/plain"
                                    putExtra(Intent.EXTRA_TEXT, summary)
                                }
                                context.startActivity(
                                    Intent.createChooser(intent, "Поделиться сравнением")
                                )
                            }
                        ) {
                            Icon(
                                imageVector = Icons.Outlined.Share,
                                contentDescription = "Поделиться сравнением"
                            )
                        }
                    }

                    Spacer(modifier = Modifier.height(10.dp))

                    ComparisonSectionSelector(
                        selectedSection = comparisonSection,
                        onSectionSelected = { comparisonSectionName = it.name }
                    )

                    Spacer(modifier = Modifier.height(12.dp))

                    when (comparisonSection) {
                        ComparisonSection.PARAMETERS -> {
                            AnimatedContent(
                                targetState = firstIndex to secondIndex,
                                transitionSpec = { fadeIn() togetherWith fadeOut() },
                                label = "comparison_table"
                            ) { (first, second) ->
                                ComparisonTable(
                                    first = aircraftList[first],
                                    second = aircraftList[second],
                                    unitSystem = unitSystem,
                                    onFirstDetails = { detailAircraftIndex = first },
                                    onSecondDetails = { detailAircraftIndex = second }
                                )
                            }
                        }

                        ComparisonSection.ROUTE -> {
                            RouteAircraftSelectorCard(
                                aircraft = routeAircraft,
                                options = allAircraftOptions,
                                unitSystem = unitSystem,
                                onSelected = { selectedIndex ->
                                    routeAircraftIndex = selectedIndex
                                    saveRouteAircraftIndex(
                                        storageContext,
                                        selectedIndex
                                    )
                                }
                            )

                            Spacer(modifier = Modifier.height(20.dp))

                            Text(
                                text = "Проверка города",
                                style = MaterialTheme.typography.titleLarge
                            )

                            Spacer(modifier = Modifier.height(4.dp))

                            Text(
                                text = "Узнай, долетит ли ${routeAircraft.fullName} до нужного города",
                                style = MaterialTheme.typography.bodySmall
                            )

                            Spacer(modifier = Modifier.height(10.dp))

                            CityRangeChecker(
                                query = cityQuery,
                                onQueryChange = { cityQuery = it },
                                matchedCity = searchedCity,
                                aircraft = routeAircraft,
                                unitSystem = unitSystem
                            )

                            if (searchedCity != null && searchedDistance != null) {
                                Spacer(modifier = Modifier.height(16.dp))

                                SuitableAircraftRow(
                                    aircraftOptions = suitableAircraft,
                                    selectedIndex = routeAircraftIndex,
                                    distanceKm = searchedDistance,
                                    unitSystem = unitSystem,
                                    onSelected = { selectedIndex ->
                                        routeAircraftIndex = selectedIndex
                                        saveRouteAircraftIndex(
                                            storageContext,
                                            selectedIndex
                                        )
                                    }
                                )
                            }

                            Spacer(modifier = Modifier.height(20.dp))

                            Text(
                                text = "Самые дальние маршруты",
                                style = MaterialTheme.typography.titleLarge
                            )

                            Spacer(modifier = Modifier.height(4.dp))

                            Text(
                                text = "${routeAircraft.fullName}: дальность ${
                                    formatDistance(
                                        routeAircraft.rangeKm.toDouble(),
                                        unitSystem
                                    )
                                } от $homeAirportName",
                                color = MaterialTheme.colorScheme.primary,
                                fontWeight = FontWeight.Medium
                            )

                            Spacer(modifier = Modifier.height(10.dp))

                            AircraftMap(
                                aircraft = routeAircraft,
                                searchedCity = searchedCity,
                                unitSystem = unitSystem
                            )

                            Spacer(modifier = Modifier.height(8.dp))

                            Text(
                                text = "Синим — дальние маршруты. Оранжевым — найденный город.",
                                style = MaterialTheme.typography.bodySmall
                            )

                            Spacer(modifier = Modifier.height(8.dp))

                            Text(
                                text = "© OpenStreetMap contributors, © CARTO",
                                fontSize = 11.sp,
                                color = MaterialTheme.colorScheme.primary
                            )
                        }
                    }
                }
            }
        }
    }
}

private fun buildShareText(
    first: Aircraft,
    second: Aircraft,
    unitSystem: UnitSystem
): String {
    return buildString {
        appendLine("Сравнение самолётов: ${first.fullName} vs ${second.fullName}")
        appendLine(
            "Дальность: ${formatDistance(first.rangeKm.toDouble(), unitSystem)} vs ${
                formatDistance(second.rangeKm.toDouble(), unitSystem)
            }"
        )
        appendLine(
            "Крейсерская скорость: ${
                formatSpeed(first.cruiseSpeedKmh, first.cruiseMach, unitSystem)
            } vs ${
                formatSpeed(second.cruiseSpeedKmh, second.cruiseMach, unitSystem)
            }"
        )
        appendLine("Вместимость: ${first.seats} vs ${second.seats}")
        appendLine(
            "Макс. масса: ${formatWeight(first.mtowKg, unitSystem)} vs ${
                formatWeight(second.mtowKg, unitSystem)
            }"
        )
    }
}

private fun buildAircraftShareText(
    aircraft: Aircraft,
    unitSystem: UnitSystem
): String {
    return buildString {
        appendLine(aircraft.fullName)
        appendLine("Семейство: ${aircraft.family}")
        appendLine("Поколение: ${aircraft.generation}")
        appendLine("Период выпуска: ${aircraft.productionPeriod}")
        appendLine("Вместимость: ${aircraft.seats}")
        appendLine(
            "Дальность: ${formatDistance(aircraft.rangeKm.toDouble(), unitSystem)}"
        )
        appendLine(
            "Крейсерская скорость: ${
                formatSpeed(aircraft.cruiseSpeedKmh, aircraft.cruiseMach, unitSystem)
            }"
        )
        appendLine("Тип: ${aircraft.aircraftType}")
        appendLine("Длина: ${formatLength(aircraft.lengthM, unitSystem)}")
        appendLine("Размах крыла: ${formatLength(aircraft.wingspanM, unitSystem)}")
        appendLine("Высота: ${formatLength(aircraft.heightM, unitSystem)}")
        appendLine(
            "Ширина салона: ${formatLength(aircraft.cabinWidthM, unitSystem)}"
        )
        appendLine(
            "Запас топлива: ${formatFuel(aircraft.fuelCapacityLiters, unitSystem)}"
        )
        appendLine("Макс. взлётная масса: ${formatWeight(aircraft.mtowKg, unitSystem)}")
        appendLine("Двигатели: ${aircraft.engine}")
        appendLine("Первый полёт: ${aircraft.firstFlight}")
        appendLine()
        appendLine("Интересный факт:")
        appendLine(aircraft.interestingFact)
        appendLine()
        appendLine("Историческая справка:")
        appendLine(aircraft.history)
    }
}

