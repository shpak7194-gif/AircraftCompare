private enum class UnitSystem {
    METRIC,
    AVIATION
}

private enum class ComparisonSection {
    PARAMETERS,
    ROUTE
}

private const val KM_TO_NAUTICAL_MILES = 0.5399568
private const val METERS_TO_FEET = 3.28084
private const val KG_TO_POUNDS = 2.20462
private const val KMH_TO_KNOTS = 0.5399568
private const val LITERS_TO_US_GALLONS = 0.264172

private fun formatDecimal(value: Double): String {
    val rounded = (value * 10).roundToInt() / 10.0
    return rounded
        .toString()
        .removeSuffix(".0")
        .replace('.', ',')
}

private fun formatMach(value: Double): String {
    val hundredths = (value * 100).roundToInt()
    val wholePart = hundredths / 100
    val decimalPart = (hundredths % 100).toString().padStart(2, '0')
    return "$wholePart,$decimalPart"
}

private fun formatDistance(km: Double, unitSystem: UnitSystem): String {
    return when (unitSystem) {
        UnitSystem.METRIC -> "${km.roundToInt()} км"
        UnitSystem.AVIATION -> "${(km * KM_TO_NAUTICAL_MILES).roundToInt()} NM"
    }
}

private fun formatLength(meters: Double, unitSystem: UnitSystem): String {
    return when (unitSystem) {
        UnitSystem.METRIC -> "${formatDecimal(meters)} м"
        UnitSystem.AVIATION -> "${formatDecimal(meters * METERS_TO_FEET)} ft"
    }
}

private fun formatWeight(kg: Int, unitSystem: UnitSystem): String {
    return when (unitSystem) {
        UnitSystem.METRIC -> "$kg кг"
        UnitSystem.AVIATION -> "${(kg * KG_TO_POUNDS).roundToInt()} lb"
    }
}

private fun formatSpeed(
    speedKmh: Int,
    mach: Double,
    unitSystem: UnitSystem
): String {
    val speed = when (unitSystem) {
        UnitSystem.METRIC -> "$speedKmh км/ч"
        UnitSystem.AVIATION -> "${(speedKmh * KMH_TO_KNOTS).roundToInt()} kt"
    }

    return "$speed · M ${formatMach(mach)}"
}

private fun formatFuel(liters: Int, unitSystem: UnitSystem): String {
    return when (unitSystem) {
        UnitSystem.METRIC -> "$liters л"
        UnitSystem.AVIATION -> "${(liters * LITERS_TO_US_GALLONS).roundToInt()} US gal"
    }
}

