}

@Composable
fun SelectionCard(
    firstAircraft: Aircraft,
    secondAircraft: Aircraft,
    options: List<Pair<Int, Aircraft>>,
    onFirstSelected: (Int) -> Unit,
    onSecondSelected: (Int) -> Unit
) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
    ) {
        Column(modifier = Modifier.padding(16.dp)) {
            Text(text = "Выбери самолёты", fontSize = 20.sp, fontWeight = FontWeight.Bold)

            Spacer(modifier = Modifier.height(16.dp))

            AircraftSelector(
                title = "Первый самолёт",
                selected = firstAircraft,
                options = options,
                onSelected = onFirstSelected
            )

            Spacer(modifier = Modifier.height(12.dp))

            AircraftSelector(
                title = "Второй самолёт",
                selected = secondAircraft,
                options = options,
                onSelected = onSecondSelected
            )

            if (options.isEmpty()) {
                Spacer(modifier = Modifier.height(12.dp))
                Text(text = "Самолёты не найдены", color = Color.Red)
            }
        }
    }
}

@Composable
fun AircraftSelector(
    title: String,
    selected: Aircraft,
    options: List<Pair<Int, Aircraft>>,
    onSelected: (Int) -> Unit
) {
    var expanded by remember { mutableStateOf(false) }

    Column {
        Text(text = title, fontWeight = FontWeight.Medium)

        Spacer(modifier = Modifier.height(6.dp))

        OutlinedButton(onClick = { expanded = true }, modifier = Modifier.fillMaxWidth()) {
            Text(text = selected.fullName, modifier = Modifier.weight(1f), textAlign = TextAlign.Start)
            Text("▼")
        }

        DropdownMenu(expanded = expanded, onDismissRequest = { expanded = false }) {
            options.forEach { option ->
                val originalIndex = option.first
                val aircraft = option.second

                DropdownMenuItem(
                    text = { Text(aircraft.fullName) },
                    onClick = {
                        onSelected(originalIndex)
                        expanded = false
                    }
                )
            }
        }
    }
}

@Composable
fun ComparisonTable(first: Aircraft, second: Aircraft) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface)
    ) {
        Column(modifier = Modifier.padding(12.dp)) {
            Row(modifier = Modifier.fillMaxWidth()) {
                Text(text = "Параметр", modifier = Modifier.weight(1.2f), fontWeight = FontWeight.Bold)
                Text(text = first.model, modifier = Modifier.weight(1f), fontWeight = FontWeight.Bold, textAlign = TextAlign.Center)
                Text(text = second.model, modifier = Modifier.weight(1f), fontWeight = FontWeight.Bold, textAlign = TextAlign.Center)
            }

            HorizontalDivider(modifier = Modifier.padding(vertical = 10.dp))

            TextComparisonRow(title = "Производитель", left = first.manufacturer, right = second.manufacturer)
            TextComparisonRow(title = "Мест", left = first.seats, right = second.seats)

            NumberComparisonRow(
                title = "Дальность",
                leftText = "${first.rangeKm} км", rightText = "${second.rangeKm} км",
                leftValue = first.rangeKm.toDouble(), rightValue = second.rangeKm.toDouble()
            )
            NumberComparisonRow(
                title = "Длина",
                leftText = "${first.lengthM} м", rightText = "${second.lengthM} м",
                leftValue = first.lengthM, rightValue = second.lengthM
            )
            NumberComparisonRow(
                title = "Размах",
                leftText = "${first.wingspanM} м", rightText = "${second.wingspanM} м",
                leftValue = first.wingspanM, rightValue = second.wingspanM
            )
            NumberComparisonRow(
                title = "Макс. масса",
                leftText = "${first.mtowKg} кг", rightText = "${second.mtowKg} кг",
                leftValue = first.mtowKg.toDouble(), rightValue = second.mtowKg.toDouble()
            )

            TextComparisonRow(title = "Двигатели", left = first.engine, right = second.engine)
        }
    }
}

@Composable
fun TextComparisonRow(title: String, left: String, right: String) {
    Row(
        modifier = Modifier.fillMaxWidth().padding(vertical = 9.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Text(text = title, modifier = Modifier.weight(1.2f), fontSize = 13.sp)
        Text(text = left, modifier = Modifier.weight(1f), fontSize = 13.sp, textAlign = TextAlign.Center)
        Text(text = right, modifier = Modifier.weight(1f), fontSize = 13.sp, textAlign = TextAlign.Center)
    }
}

@Composable
fun NumberComparisonRow(title: String, leftText: String, rightText: String, leftValue: Double, rightValue: Double) {
    Row(
        modifier = Modifier.fillMaxWidth().padding(vertical = 7.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Text(text = title, modifier = Modifier.weight(1.2f), fontSize = 13.sp)
        ValueCell(text = leftText, highlighted = leftValue > rightValue, modifier = Modifier.weight(1f))
        Spacer(modifier = Modifier.width(4.dp))
        ValueCell(text = rightText, highlighted = rightValue > leftValue, modifier = Modifier.weight(1f))
    }
}

@Composable
fun ValueCell(text: String, highlighted: Boolean, modifier: Modifier) {
    Text(
        text = text,
        modifier = modifier
            .background(
                color = if (highlighted) Color(0xFFDFF5E1) else Color.Transparent,
                shape = RoundedCornerShape(8.dp)
            )
            .padding(vertical = 6.dp, horizontal = 3.dp),
        color = if (highlighted) Color(0xFF123D18) else MaterialTheme.colorScheme.onSurface,
        textAlign = TextAlign.Center,
        fontSize = 13.sp,
        fontWeight = if (highlighted) FontWeight.Bold else FontWeight.Normal
    )
}

