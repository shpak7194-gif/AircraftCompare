@Composable
fun AircraftMap(aircraft: Aircraft) {
    val context = LocalContext.current

    val mapView = remember {
        MapView(context).apply {
            layoutParams = android.view.ViewGroup.LayoutParams(
                android.view.ViewGroup.LayoutParams.MATCH_PARENT,
                android.view.ViewGroup.LayoutParams.MATCH_PARENT
            )

            setTileSource(cartoTileSource)
            setMultiTouchControls(true)
            controller.setZoom(3.0)
            controller.setCenter(homeAirport)

            setOnTouchListener { view, event ->
                parent?.requestDisallowInterceptTouchEvent(true)
                view.performClick()
                false
            }
        }
    }

    DisposableEffect(mapView) {
        onDispose { mapView.onDetach() }
    }

    LaunchedEffect(aircraft.fullName, aircraft.rangeKm) {
        mapView.overlays.clear()

        val homeMarker = Marker(mapView).apply {
            position = homeAirport
            title = homeAirportName
        }
        mapView.overlays.add(homeMarker)

        val routes = farthestReachableCities(aircraft.rangeKm)

        routes.forEach { (city, distance) ->
            val line = Polyline(mapView).apply {
                setPoints(greatCirclePoints(homeAirport, city.point))
                outlinePaint.color = 0xFF1565C0.toInt()
                outlinePaint.strokeWidth = 4f
            }
            mapView.overlays.add(line)

            val marker = Marker(mapView).apply {
                position = city.point
                title = city.name
                snippet = "${distance.roundToInt()} км от $homeAirportName"
            }
            mapView.overlays.add(marker)
        }

        mapView.invalidate()
    }

    Box(
        modifier = Modifier
            .fillMaxWidth()
            .height(360.dp)
            .clip(RoundedCornerShape(12.dp))
    ) {
        AndroidView(
            factory = { mapView },
            modifier = Modifier.fillMaxSize()
        )
    }
}
