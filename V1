@Composable
fun AircraftSelector(
    title: String,
    selected: Aircraft,
    options: List<Pair<Int, Aircraft>>,
    onSelected: (Int) -> Unit
) {
    var expanded by remember { mutableStateOf(false) }
    val groupedOptions = remember(options) {
        options
            .groupBy { (_, aircraft) -> aircraft.family }
            .map { (family, familyOptions) ->
                family to familyOptions.sortedBy { (_, aircraft) ->
                    aircraftModelOrder.indexOf(aircraft.model).let { index ->
                        if (index >= 0) index else Int.MAX_VALUE
                    }
                }
            }
            .toList()
            .sortedBy { (family, _) ->
                aircraftFamilyOrder.indexOf(family).let { index ->
                    if (index >= 0) index else Int.MAX_VALUE
                }
            }
    }

    Column {
        Text(text = title, style = MaterialTheme.typography.labelLarge)

        Spacer(modifier = Modifier.height(6.dp))

        OutlinedButton(
            onClick = { expanded = true },
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(12.dp)
        ) {
            ManufacturerBadge(selected.manufacturer)
            Spacer(modifier = Modifier.width(8.dp))
            Column(modifier = Modifier.weight(1f)) {
                Text(
                    text = selected.model,
                    textAlign = TextAlign.Start,
                    fontWeight = FontWeight.SemiBold
                )
                Text(
                    text = selected.family,
                    style = MaterialTheme.typography.bodySmall
                )
            }
            Text("▼")
        }

        if (expanded) {
            Dialog(onDismissRequest = { expanded = false }) {
                Card(
                    modifier = Modifier
                        .fillMaxWidth()
                        .heightIn(max = 680.dp),
                    shape = RoundedCornerShape(20.dp),
                    colors = CardDefaults.cardColors(
                        containerColor = MaterialTheme.colorScheme.surface
                    )
                ) {
                    Column(modifier = Modifier.padding(16.dp)) {
                        Row(
                            modifier = Modifier.fillMaxWidth(),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Column(modifier = Modifier.weight(1f)) {
                                Text(
                                    text = "Выберите самолёт",
                                    style = MaterialTheme.typography.titleLarge
                                )
                                Text(
                                    text = "Модели сгруппированы по семействам",
                                    style = MaterialTheme.typography.bodySmall
                                )
                            }

                            TextButton(onClick = { expanded = false }) {
                                Text("Закрыть")
                            }
                        }

                        Spacer(modifier = Modifier.height(8.dp))

                        if (groupedOptions.isEmpty()) {
                            Text(
                                text = "Нет моделей для выбранного производителя",
                                modifier = Modifier.padding(vertical = 24.dp),
                                style = MaterialTheme.typography.bodyMedium
                            )
                        } else {
                            LazyColumn(modifier = Modifier.weight(1f)) {
                                groupedOptions.forEach { (family, familyOptions) ->
                                    item(key = "header_$family") {
                                        Text(
                                            text = family,
                                            modifier = Modifier
                                                .fillMaxWidth()
                                                .background(
                                                    MaterialTheme.colorScheme.surfaceVariant,
                                                    RoundedCornerShape(8.dp)
                                                )
                                                .padding(
                                                    horizontal = 12.dp,
                                                    vertical = 8.dp
                                                ),
                                            color = MaterialTheme.colorScheme.primary,
                                            fontWeight = FontWeight.Bold
                                        )
                                    }

                                    items(
                                        items = familyOptions,
                                        key = { (index, _) -> index }
                                    ) { (originalIndex, aircraft) ->
                                        TextButton(
                                            onClick = {
                                                onSelected(originalIndex)
                                                expanded = false
                                            },
                                            modifier = Modifier.fillMaxWidth(),
                                            contentPadding = PaddingValues(
                                                horizontal = 12.dp,
                                                vertical = 8.dp
                                            )
                                        ) {
                                            Column(
                                                modifier = Modifier.weight(1f),
                                                horizontalAlignment = Alignment.Start
                                            ) {
                                                Text(
                                                    text = aircraft.model,
                                                    color = MaterialTheme.colorScheme.onSurface,
