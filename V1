    val mainScrollState = rememberScrollState()

    var firstIndex by rememberSaveable { mutableStateOf(0) }
    var secondIndex by rememberSaveable { mutableStateOf(4) }
    var manufacturerFilter by rememberSaveable { mutableStateOf("Все") }
    var darkTheme by remember(storageContext) {
        mutableStateOf(loadDarkTheme(storageContext))
    }
    var cityQuery by rememberSaveable { mutableStateOf("") }
    var detailAircraftIndex by rememberSaveable { mutableStateOf<Int?>(null) }
    var comparisonSectionName by rememberSaveable {
        mutableStateOf(ComparisonSection.PARAMETERS.name)
    }
    var unitSystem by remember(storageContext) {
        mutableStateOf(loadUnitSystem(storageContext))
    }
    var routeAircraftIndex by remember(storageContext) {
        mutableStateOf(loadRouteAircraftIndex(storageContext))
    }

    val favorites = remember(storageContext) {
        mutableStateListOf<FavoritePair>().apply {
            addAll(loadFavoritePairs(storageContext))
        }
    }

    val firstAircraft = aircraftList[firstIndex]
    val secondAircraft = aircraftList[secondIndex]
    val routeAircraft = aircraftList[routeAircraftIndex]
    val allAircraftOptions = remember {
        aircraftList.mapIndexed { index, aircraft -> index to aircraft }
    }

    val filteredAircraft = allAircraftOptions
        .filter { (_, aircraft) ->
            manufacturerFilter == "Все" || aircraft.manufacturer == manufacturerFilter
        }

    val searchedCity = remember(cityQuery) {
        if (cityQuery.isBlank()) null
        else worldCities.firstOrNull { it.name.contains(cityQuery, ignoreCase = true) }
    }
    val searchedDistance = remember(searchedCity) {
        searchedCity?.let { haversineKm(homeAirport, it.point) }
